APP_NAME=PedNia
APP_ENV=production
# Generar en el servidor con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Servicio local de texto a voz (TextoAVozService). Los MP3 se cachean en
# storage/app/public/tts; sin este servicio solo suenan los textos ya cacheados.
EDGE_TTS_URL=http://127.0.0.1:9000
EDGE_TTS_TIMEOUT=60

# Ambiente que atiende este despliegue (uno de config('ambiente.slugs')):
# expresion-artistica | polimotor | multisaberes | multisensorial | tecnologia
AMBIENTE_SLUG=

# true = usar AMBIENTE_SLUG aunque la IP del nodo coincida con otro ambiente.
# En hosting (Plesk) no hay IP de nodo LAN: dejar en true.
AMBIENTE_PRIORIZAR_SLUG=true

# Solo para simulación local (IP de la tablet → ambiente según ambiente_institucion)
AMBIENTE_NODO_IP=

# Sincronización entre nodos (config/red.php).
# Vacío = no se encolan cambios en cola_sincronizacion (recomendado en hosting sin LAN).
SERVIDOR_AMBIENTE=
PUERTO_SYNC=80
IP_EXPRESION_ARTISTICA=192.168.1.20
IP_POLIMOTOR=192.168.1.21
IP_MULTISABERES=192.168.1.22
IP_MULTISENSORIAL=192.168.1.23
IP_TECNOLOGIA=192.168.1.24
