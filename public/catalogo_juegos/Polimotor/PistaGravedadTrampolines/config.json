    "demoMover": "¡Mira! Pon tu dedo en la pista y la esfera rueda hacia tu dedo.",
    "demoAgujero": "¡Mueve la esfera suavemente para no caer en los agujeros!",
    "demoTrampolin": "¡Apunta al trampolín amarillo para volar sobre la pared!",
    "demoFin": "¡Ahora es tu turno! ¡Lleva la esfera hasta la meta!",
    "demostracionBien": "¡Así se hace!",
    "botonComenzar": "¡COMENZAR!",
    "pistaArrastra": "Pon tu dedo sobre la pista, cerca de la esfera, y muévelo despacio: la esfera rueda hacia tu dedo.",
    "agujero": "¡Mueve la esfera suavemente para no caer en los agujeros!",
    "trampolin": "¡Apunta al trampolín amarillo para volar sobre la pared!",
    "caida": "¡Uy, se cayó! ¡El rayo mágico la rescata! Sigue desde aquí.",
    "pared": "¡La pared no se puede cruzar caminando! Busca el trampolín amarillo.",
    "orientacion": "¡Mira los destellos! Te muestran el camino que sigue.",
    "rampaBaja": "¡Rampa abajo! La esfera va más rápido, ¡con cuidado!",
    "rampaSube": "¡Rampa arriba! Empuja con calma para subir.",
    "progreso": "RECORRIDO",
    "recorridoBien": "¡Recorrido superado! ¡Vamos por el siguiente!",
    "recorridoNuevo": "¡Un recorrido nuevo, con más curvas y saltos! ¡Tú puedes!",
    "cierre": "¡GENIALIDAD POLIMOTORA! Dominaste la gravedad, la aceleración y los saltos para superar el gran laberinto de coordinación.",
    "finalTitulo": "¡GENIALIDAD POLIMOTORA!",
    "finalSub": "Superaste el gran laberinto de coordinación",
    "finalNube": "¡GENIALIDAD POLIMOTORA!",
    "finalZeus": "¡Qué saltos tan geniales! ¡Eres campeón de la gravedad!",
    "resumenTitulo": "¡LABERINTO SUPERADO!",
    "resumenSub": "Dominaste la gravedad y los trampolines",
    "resumenRecorridos": "Recorridos completados",
